+// maxGSOSegmentsLW is UDP_MAX_SEGMENTS of older kernels (64); with small packets
+// the 20 KiB buffer could otherwise hold more segments than the kernel accepts.
+const maxGSOSegmentsLW = 64
+
+// gsoSizeLW keeps upstream's gsoSize (maxSize) for a single-packet batch.
+func gsoSizeLW(buf *packetBuffer, segSize, maxSize protocol.ByteCount) uint16 {
+	if buf.Len() <= segSize {
+		return uint16(maxSize)
+	}
+	return uint16(segSize)
+}
+
+// pendingPacketLW is a packed packet that split a GSO batch when the send queue
+// filled up; sendPackets sends it first (the run loop calls it with a free slot).
+type pendingPacketLW struct {
+	buf *packetBuffer
+	ecn protocol.ECN
+}
+
+// flushPendingLW reports whether the send queue is still free afterwards.
+func (c *Conn) flushPendingLW() bool {
+	if c.pendingLW.buf == nil {
+		return true
 	}
+	p := c.pendingLW
+	c.pendingLW = pendingPacketLW{}
+	c.sendQueue.Send(p.buf, uint16(c.maxPacketSize()), p.ecn)
+	return !c.sendQueue.WouldBlock()
 }
 
